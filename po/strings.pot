#: prefs.js:163
msgid "Finding an app ID or WM_CLASS"
msgstr ""

#: prefs.js:170
msgid ""
"Desktop app ID: Use the app's .desktop filename. You can find it in:\n"
"\n"
"   ~/.local/share/applications\n"
"   /usr/share/applications\n"
"\n"
"   Example: org.mozilla.firefox.desktop\n"
"\n"
"WM_CLASS on X11 or XWayland: Run \"xprop WM_CLASS\" in Terminal, then click "
"the target window.\n"
"\n"
"Wayland: Press Alt+F2, enter \"lg\", open the Windows section, and find the "
"app ID or WM_CLASS."
msgstr ""

